# DDD-Enforcer Backend Environment Variables
# Copy this file to .env and fill in your keys.

# Gemini API Key (1 key, required for GeminiClient / G1 + G2 models)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Ollama Cloud API keys (comma-separated pool, required for OllamaClient /
# O1-O4 OSS models). The retry decorator rotates through the pool on 429/5xx.
# Recommended: 6 keys for D1 6-model RQ runs.
OLLAMA_API_KEYS=key1,key2,key3,key4,key5,key6

# Optional: override the conservative free-tier rate-limit floor.
# DDD_MIN_DELAY_SECONDS=1.0   # Pro-tier RPM headroom; default 6.0 is free-tier safe

# Optional: parallel Scout chunk extraction (Pro-tier only; default 1).
# DDD_SCOUT_MAX_WORKERS=4

# Optional: Critic revision loop priority threshold.
# Options: HIGH_MED (default - maximum semantic precision), HIGH (cost-efficient, single-cycle)
# DDD_CRITIC_THRESHOLD=HIGH_MED
