{
  "include": ["extension/backend"],
  "extraPaths": ["extension/backend"],
  "exclude": [
    "**/__pycache__",
    "**/intermediate",
    "**/node_modules",
    "**/.pytest_cache",
    "**/.venv",
    "extension/backend/legacy_pre_emse",
    "extension/out"
  ],
  "venvPath": "extension/backend",
  "venv": ".venv",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none",
  "pythonVersion": "3.12"
}
