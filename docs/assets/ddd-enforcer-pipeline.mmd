flowchart TB
  classDef source fill:#F4F7FB,stroke:#375A7F,color:#172033,stroke-width:1.5px
  classDef agent fill:#EAF3FF,stroke:#1F6FEB,color:#102A43,stroke-width:1.5px
  classDef deterministic fill:#ECF8F0,stroke:#2F855A,color:#173B2A,stroke-width:1.5px
  classDef review fill:#FFF4E5,stroke:#B7791F,color:#4A2D0A,stroke-width:1.5px
  classDef artifact fill:#F5EEFF,stroke:#805AD5,color:#2D1B54,stroke-width:1.5px
  classDef ide fill:#FDEFF4,stroke:#B83280,color:#4A1534,stroke-width:1.5px

  SRS["SRS documents<br/>PDF, DOCX, TXT"]:::source --> Parser["Defensive parser"]:::deterministic

  subgraph Extract["Evidence to tactical model"]
    direction LR
    Scout["Scout<br/>evidence segmentation"]:::agent --> Architect["Architect<br/>bounded contexts"]:::agent
    Architect --> Specialist["Specialist<br/>tactical DDD model"]:::agent
  end

  Parser --> Scout

  subgraph Quality["Typed quality and strategic design"]
    direction LR
    Verifier{"Verifier"}:::deterministic -.->|"findings"| Refiner["Bounded correction router"]:::review
    Verifier -->|"accepted"| Synthesizer["Synthesizer"]:::agent
    Refiner -.->|"context correction"| Architect
    Refiner -.->|"tactical correction"| Specialist
    Synthesizer --> Mapper["Context Mapper"]:::agent
    Mapper --> Critic{"Holistic Critic<br/>bounded review and<br/>best-model selection"}:::review
    Critic -.->|"producer feedback"| Architect
    Critic -.->|"producer feedback"| Specialist
    Critic -.->|"relationship feedback"| Mapper
    Critic -->|"best model"| Enrichment["AST and import<br/>topology enrichment"]:::deterministic
  end

  Specialist --> Verifier
  Enrichment --> Model[("domain/model.json")]:::artifact
  Parser --> RAG[("Chroma RAG index")]:::artifact

  subgraph Validate["Validation on Python save"]
    direction LR
    Save["Python save"]:::source --> Fingerprint["Semantic fingerprint"]:::deterministic
    Fingerprint --> Signals["AST signal extraction"]:::deterministic
    Signals --> Checks["Deterministic DDD checks"]:::deterministic
    Signals --> Gate{"Advanced signals?"}:::deterministic
    Gate -->|"yes"| Advanced["Advanced LLM analysis"]:::agent
    Gate -->|"no"| Merge["Merge findings"]:::deterministic
    Checks --> Merge
    Advanced --> Merge
    Merge --> Findings["Traceable violations"]:::review
  end

  Model --> Checks
  Model --> Advanced
  RAG --> Findings
  Findings --> Diagnostics["VS Code diagnostics<br/>hover, suggestion, SRS reference"]:::ide
